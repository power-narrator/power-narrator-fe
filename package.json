{
  "name": "power-narrator",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"pnpm run dev:electron\"",
    "dev:electron": "pnpm run build:electron && concurrently -k \"pnpm run build:electron --watch\" \"electron .\"",
    "build": "pnpm run typecheck && vite build && pnpm run build:electron",
    "build:electron": "tsc -p electron",
    "dist": "pnpm run build && electron-builder",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run src electron",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@gfazioli/mantine-split-pane": "^4.1.5",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@mantine/core": "^9.3.0",
    "@tabler/icons-react": "^3.44.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "electron": "^42.3.1",
    "electron-builder": "^26.14.0",
    "globals": "^17.6.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "playwright": "^1.60.0",
    "pptxgenjs": "^1.1.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
