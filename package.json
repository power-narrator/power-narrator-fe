{
  "name": "power-narrator",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"pnpm run dev:electron\"",
    "dev:electron": "pnpm run build:electron && concurrently -k \"pnpm run build:electron --watch\" \"electron .\"",
    "build": "pnpm run typecheck && vite build && pnpm run build:electron",
    "build:electron": "tsc -p tsconfig.build.json",
    "dist": "pnpm run build && electron-builder",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm run test:unit && pnpm run test:component && pnpm run test:integration && pnpm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@gfazioli/mantine-split-pane": "^4.1.12",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@mantine/core": "^9.6.1",
    "@tabler/icons-react": "^3.46.0",
    "dotenv": "^18.0.0",
    "electron-store": "^11.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "globals": "^17.12.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-config-presets": "^0.1.20",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
